# Configure um provedor. Gemini usa Google AI Studio; openai_compatible serve
# para endpoints compatíveis (por exemplo Groq ou OpenRouter).
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
MAX_OUTPUT_TOKENS=900
LLM_TIMEOUT_SECONDS=120
# Opcional: provedor reserva, chamado automaticamente em 429, 5xx, timeout
# ou resposta inválida do provedor principal. Mantenha chaves diferentes.
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_API_KEY=
FALLBACK_GEMINI_MODEL=gemini-3.1-flash-lite
DATABASE_PATH=centralizador.db
# Gere com: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=
# Opcional no primeiro deploy; localmente o primeiro admin pode ser criado em localhost.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=false
